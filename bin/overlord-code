#!/usr/bin/env bash
# ==================================================
#  overlord-code - launch the Aider coding agent with Overlord voice cues
#  Usage:  overlord-code          (starts aider in the current project)
# ==================================================
SAY="$HOME/.local/bin/overlord-say"
export OLLAMA_API_BASE="http://localhost:11434"

"$SAY" ready 2>/dev/null &
echo "  [OVERLORD] Coding agent online. Qwen at the controls."
exec aider "$@"
