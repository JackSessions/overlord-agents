#!/usr/bin/env bash
# ==================================================
#  overlord-find - search & play ANY of Overlord's 155 real voice lines
#  Usage:  overlord-find mission      (play first line matching 'mission')
#          overlord-find --search cover   (list matches, don't play)
#          overlord-find --all        (list every line)
# ==================================================
LIB="$HOME/.local/share/overlord/library"
IDX="$LIB/index.tsv"

[[ ! -f "$IDX" ]] && { echo "library not found"; exit 1; }

if [[ "$1" == "--all" ]]; then
    nl -w3 -s'  ' <(cut -f2 "$IDX")
    exit 0
fi

if [[ "$1" == "--search" ]]; then
    shift
    grep -i "$*" "$IDX" | cut -f2 | nl -w3 -s'  '
    exit 0
fi

[[ -z "$1" ]] && { echo "usage: overlord-find <keywords> | --search <kw> | --all"; exit 1; }

# Find matching lines, pick one at random among matches, play it
match=$(grep -i "$*" "$IDX" | shuf -n1)
if [[ -z "$match" ]]; then
    echo "overlord-find: no line matching '$*'"
    echo "try: overlord-find --search <word>"
    exit 1
fi
file=$(echo "$match" | cut -f1)
text=$(echo "$match" | cut -f2)
echo "  [OVERLORD] $text"
paplay "$LIB/$file" 2>/dev/null
