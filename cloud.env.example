# Overlord cloud brain — OpenAI-compatible endpoint (optional, agents work locally without it)
# Copy this file to ~/.config/overlord/cloud.env and fill in your own values, then: chmod 600 it.
#
# Works with any OpenAI-compatible API: Alibaba Qwen/DashScope, Groq, Gemini (OpenAI mode),
# OpenRouter, Together, etc. Agents fall back to local Ollama when this is absent or offline.

OVERLORD_CLOUD_BASE="https://your-endpoint.example.com/compatible-mode/v1"
OVERLORD_CLOUD_KEY="sk-REPLACE_WITH_YOUR_OWN_KEY"
OVERLORD_CLOUD_MODEL="qwen3.7-plus"
